# Riverbend — slice 001 configuration. Copy to .env and fill in. NEVER commit real secrets.
# The application refuses to start if a required setting is missing or empty (FR-014).

# --- Required ---
# Application runtime connection (non-owner role: app_user, RLS enforced).
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/riverbend
# Admin/auth runtime connection (role: app_admin, cross-shop for provisioning + credential lookup).
DATABASE_ADMIN_URL=postgres://app_admin:admin_pw@localhost:5432/riverbend
# Migration/owner connection (owns the schema; runs migrations only).
DATABASE_MIGRATOR_URL=postgres://riverbend_migrator:mig_pw@localhost:5432/riverbend
# Initial administrative credential secret. Fingerprinted at startup; no default exists (FR-021).
# The operator then authenticates admin calls with Bearer token: rb_admin_bootstrap.<this value>
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-admin-secret

# --- Optional (have safe defaults) ---
# HTTP port the api process listens on.
PORT=8080
# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Reserved for later customer-facing signed tokens (slices 005/006). Unused in 001.
# TOKEN_SIGNING_KEY=

# --- Slice 002 (intake & queue) ---
# Total processing attempts incl. the first; maps to pg-boss retryLimit = MAX - 1 (FR-011).
MAX_PROCESSING_ATTEMPTS=3
# pg-boss job lease/expiration in seconds (drives crash recovery; set above worst-case run time).
QUEUE_EXPIRE_SECONDS=120
# Reconciler poll interval in ms (outbox delivery backstop + exhaustion → needs_review).
RECONCILER_INTERVAL_MS=10000

# --- Slice 003 real provider (D6): worker → LlmGateway → LiteLlmGateway → LiteLLM proxy → OpenAI ---
# Riverbend never talks to OpenAI directly. The LiteLLM proxy holds the provider key and does routing;
# the worker talks only to the proxy. PLACEHOLDERS ONLY below — put real values in .env (git-ignored),
# NEVER here. Leave these unset to run fully offline on the deterministic FakeGateway (what the test
# suite and the default `make up` use — no key, no network).
#
# To go live: set real values in .env, then start the proxy with the stack:
#   docker compose --profile llm up
#
# Backing-provider (OpenAI) key. Read ONLY by the LiteLLM proxy container; the app never sees it.
OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-OPENAI-KEY
# Proxy master key. Required by the proxy; the worker must present the SAME value as LLM_API_KEY.
# Generate a strong random value, e.g.  sk-$(openssl rand -hex 24)
LITELLM_MASTER_KEY=replace-with-a-generated-proxy-secret
# Worker → proxy endpoint (internal-only compose service name, OpenAI-compatible /v1 base). Setting
# LLM_BASE_URL + LLM_MODEL is what switches the worker from the FakeGateway to the LiteLlmGateway.
LLM_BASE_URL=http://litellm:4000/v1
# Logical model alias the worker requests; litellm/config.yaml maps it to the backing OpenAI model.
# Backing model (set in litellm/config.yaml, not here): openai/gpt-5.4-mini-2026-03-17 (D26, 2026-11-06).
# Rollback = change that one line in config.yaml back to openai/gpt-4o-mini; this alias stays the same.
LLM_MODEL=riverbend-extraction
# Master key the worker uses ONLY to provision teams/virtual keys (admin path), never for inference.
# Must equal LITELLM_MASTER_KEY above.
LLM_MASTER_KEY=replace-with-a-generated-proxy-secret
# (Legacy; unused under BUDGET_AUTHORITY=litellm — the worker resolves a per-shop virtual key at runtime.)
LLM_API_KEY=
# Per-call model timeout in milliseconds (optional; default 20000).
LLM_TIMEOUT_MS=20000

# Budget authority (constitution 2.0.0): 'litellm' (proxy enforces per-shop team budgets — SOLE
# authority) or 'legacy' (Riverbend reserve-then-settle hard cap, for rollback).
BUDGET_AUTHORITY=litellm
# Per-shop LiteLLM team budget (USD) and reset period.
LITELLM_TEAM_BUDGET_USD=5
LITELLM_BUDGET_DURATION=30d

# --- Slice 005 public web form (D11) ---
# The web surface (/f) is OFF unless a signing key is set (fail-closed; keeps the keyless default run).
# HMAC key for per-shop form + status tokens (I8/III). Generate, e.g.  openssl rand -hex 32
WEB_FORM_SIGNING_KEY=replace-with-a-generated-web-signing-key
# Comma-separated host allowlist for the public submit endpoint (empty → allow, for local dev).
WEB_ALLOWED_ORIGINS=
# Cloudflare Turnstile secret; when set, the real bot check is used (else a passing offline fake).
# TURNSTILE_SECRET=

# --- Slice 006 email (D21: Resend is the sole email provider; Mailpit/SMTP retired) ---
# Reply-token correlation is OFF unless EMAIL_SIGNING_KEY is set; outbound sends through Resend only when
# RESEND_API_KEY is set (else an in-memory no-op — the keyless default + offline tests are unchanged);
# the inbound webhook mounts only when RESEND_WEBHOOK_SECRET is also set. See specs/006-email/quickstart.md.
#
# Signs reply-correlation tokens (reply+<token>@). Generate, e.g.  openssl rand -hex 32
EMAIL_SIGNING_KEY=replace-with-a-generated-email-signing-key
# Resend SDK key — used by the WORKER for outbound send + inbound polling/content fetch (never the browser).
RESEND_API_KEY=re_REPLACE-WITH-YOUR-RESEND-API-KEY
# Verified sender. Before verifying a domain you may only send to your OWN account email; use resend.dev:
RESEND_FROM=Riverbend Cycles <onboarding@resend.dev>
# Receiving domain for reply+<token>@ addresses. Domain-free: your Resend-managed address, e.g. <id>.resend.app.
RESEND_REPLY_DOMAIN=riverbend.example
# Bounded outbound send attempts before the request is parked needs_review (optional; default 5).
EMAIL_MAX_SEND_ATTEMPTS=5
#
# Inbound mode 1 — Resend API POLLING (D21.1, DEFAULT local/MVP; no webhook, public URL, or tunnel).
# The worker lists received emails on an interval, discovers + fetches + correlates them. Active when
# RESEND_API_KEY + EMAIL_SIGNING_KEY are set and RESEND_POLLING_ENABLED is not 'false'.
RESEND_POLLING_ENABLED=true
RESEND_POLL_INTERVAL_SECONDS=60
#
# Inbound mode 2 — WEBHOOKS (optional; production, lower latency). Set RESEND_WEBHOOK_SECRET to the Svix
# signing secret from the Resend webhook details page; the API then verifies POST /webhooks/resend. Leave
# unset for polling-only mode. Polling + webhooks may run together (Message-ID dedup → one effect).
# RESEND_WEBHOOK_SECRET=whsec_REPLACE-WITH-YOUR-RESEND-WEBHOOK-SECRET

# --- Slice 007 resilience (D13/D15/D16) ---
# Global kill switch: when true, no model calls are made and requests park held_budget (staff: "AI paused").
AI_PAUSED=false
# Circuit breaker around the model call.
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=30000
# Per-shop bulkhead: max concurrent in-flight model calls for one shop.
AI_MAX_CONCURRENCY_PER_SHOP=4
# --- Slice 010 staff portal (Better Auth) ---
# The admin/staff browser portal (/admin, /staff) is OFF unless BETTER_AUTH_SECRET is set (fail-closed).
# Generate a strong random value, e.g.  openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-generated-auth-secret
# Public base URL (used for cookies + trusted origins; Secure cookies when NODE_ENV=production).
BETTER_AUTH_URL=http://localhost:8080
