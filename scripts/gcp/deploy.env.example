# Copy to scripts/gcp/deploy.staging.env (or deploy.prod.env) and fill in. This file is GITIGNORED.
# Only PROVIDER keys and optional overrides go here — all signing/auth keys + DB passwords are GENERATED
# by the deploy script and appended here on first run (so re-runs are idempotent). Never commit this file.

# Required: the real OpenAI key the LiteLLM proxy uses (held only inside the proxy container).
OPENAI_API_KEY=sk-...

# Optional: Resend key for outbound/inbound email (leave blank to run with email disabled).
RESEND_API_KEY=

# Optional overrides (otherwise generated on first deploy and appended below by the script):
# ADMIN_BOOTSTRAP_TOKEN=
# LITELLM_MASTER_KEY=
# RESEND_REPLY_DOMAIN=riverbend.example
